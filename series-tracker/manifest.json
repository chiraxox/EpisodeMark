{
  "manifest_version": 3,
  "name": "Series Tracker & Auto-Resume",
  "version": "1.0.0",
  "description": "Tracks episode timestamps across third-party embeds and shows a Resume at XX:XX? button.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Series Tracker"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}